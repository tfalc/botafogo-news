{
  "name": "botafogo-portal",
  "private": true,
  "scripts": {
    "setup:python": "node tools/setup_venv.mjs",
    "setup:python:recreate": "node tools/setup_venv.mjs --recreate",
    "prepare:content": "node tools/prepare-web.mjs",
    "validate": "node tools/run-python.mjs tools/validate_content.py",
    "objectives": "node tools/run-python.mjs tools/compute_objectives.py",
    "curate": "node tools/run-python.mjs tools/curate_rss.py",
    "update:standings": "node tools/run-python.mjs tools/update_standings.py --competition brasileirao",
    "cms": "decap-server",
    "cms-tools": "node tools/cms_tools_server.mjs",
    "watch:content": "node tools/content-watch.mjs",
    "start": "npm --prefix apps/web start",
    "dev": "concurrently -k -n web,cms,sync,tools -c cyan,magenta,yellow,green \"npm run start\" \"npm run cms\" \"npm run watch:content\" \"npm run cms-tools\"",
    "build": "npm --prefix apps/web run build -- --base-href=/botafogo-news/"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "decap-server": "^3.2.0"
  }
}
